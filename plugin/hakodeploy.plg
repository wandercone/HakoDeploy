<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN>

<PLUGIN 
  name="hakodeploy"
  author="wandercone"
  version="2026.05.28"
  launch="Utilities/HakoDeploy"
  pluginURL="https://raw.githubusercontent.com/wandercone/HakoDeploy/main/plugin/hakodeploy.plg"
  support="https://forums.unraid.net/topic/197930-plugin-hakodeploy/"
  
  
  icon="server"
>

<CHANGES>
<![CDATA[

### 2026.05.28

fix: turns out unraid emhttp requires csrf when working with forms

### 2026.05.23

fix: removed csrf because its causing too much problem

### 2026.03.31

- chore: address php-cs-fixer comments
- fix: rework csrf similar to other devs


For older releases, see https://github.com/wandercone/HakoDeploy/releases
]]>
</CHANGES>

<FILE Name="/boot/config/plugins/hakodeploy/hakodeploy-2026.05.28-noarch-1.txz">
<URL>https://github.com/wandercone/HakoDeploy/releases/download/2026.05.28/hakodeploy-2026.05.28-noarch-1.txz</URL>
<SHA256>07d2b8db3566e674a04e343b09d46d916fdf3e14bcaa5d4d36e90ff4edc5cdf9</SHA256>
</FILE>

<!--
The 'install' script.
-->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
upgradepkg --install-new /boot/config/plugins/hakodeploy/hakodeploy-2026.05.28-noarch-1.txz

# cleanup old versions
rm -f $(ls /boot/config/plugins/hakodeploy/hakodeploy-*.txz 2>/dev/null | grep -v '2026.05.28')

echo ""
echo "----------------------------------------------------"
echo " hakodeploy has been installed."
echo " Version: 2026.05.28"
echo "----------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<!--
The 'remove' script.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
removepkg hakodeploy

rm -rf /usr/local/emhttp/plugins/hakodeploy
rm -rf /boot/config/plugins/hakodeploy
]]>
</INLINE>
</FILE>

</PLUGIN>
