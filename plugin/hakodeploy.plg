<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN>

<PLUGIN 
  name="hakodeploy"
  author="wandercone"
  version="2026.03.24.02"
  launch="Utilities/HakoDeploy"
  pluginURL="https://raw.githubusercontent.com/wandercone/HakoDeploy/main/plugin/hakodeploy.plg"
  support="https://forums.unraid.net/topic/197930-plugin-hakodeploy/"
  
  
  icon="server"
>

<CHANGES>
<![CDATA[

### 2026.03.24.02

- fix(ajax): change $varIni from mixed to string
- chore: parse varIni only once & add fix display on plugin page

### 2026.03.24.01

fix: validate csrf token server-side in ajax.php

### 2026.03.24

Initial release of plugin


For older releases, see https://github.com/wandercone/HakoDeploy/releases
]]>
</CHANGES>

<FILE Name="/boot/config/plugins/hakodeploy/hakodeploy-2026.03.24.02-noarch-1.txz">
<URL>https://github.com/wandercone/HakoDeploy/releases/download/2026.03.24.02/hakodeploy-2026.03.24.02-noarch-1.txz</URL>
<SHA256>cd905615e0c10ff54ba18103876fdcf68155426bc65b8c87e25c8110a3a8990f</SHA256>
</FILE>

<!--
The 'install' script.
-->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
upgradepkg --install-new /boot/config/plugins/hakodeploy/hakodeploy-2026.03.24.02-noarch-1.txz

# cleanup old versions
rm -f $(ls /boot/config/plugins/hakodeploy/hakodeploy-*.txz 2>/dev/null | grep -v '2026.03.24.02')

echo ""
echo "----------------------------------------------------"
echo " hakodeploy has been installed."
echo " Version: 2026.03.24.02"
echo "----------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<!--
The 'remove' script.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
removepkg hakodeploy

rm -rf /usr/local/emhttp/plugins/hakodeploy
rm -rf /boot/config/plugins/hakodeploy
]]>
</INLINE>
</FILE>

</PLUGIN>
