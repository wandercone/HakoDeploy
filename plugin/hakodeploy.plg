<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN>

<PLUGIN 
  name="hakodeploy"
  author="wandercone"
  version="2026.05.23"
  launch="Utilities/HakoDeploy"
  pluginURL="https://raw.githubusercontent.com/wandercone/HakoDeploy/main/plugin/hakodeploy.plg"
  support="https://forums.unraid.net/topic/197930-plugin-hakodeploy/"
  
  
  icon="server"
>

<CHANGES>
<![CDATA[

### 2026.05.23

fix: removed csrf because its causing too much problem

### 2026.03.31

- chore: address php-cs-fixer comments
- fix: rework csrf similar to other devs

### 2026.03.30

chore: move icon.png into images folder of assets


For older releases, see https://github.com/wandercone/HakoDeploy/releases
]]>
</CHANGES>

<FILE Name="/boot/config/plugins/hakodeploy/hakodeploy-2026.05.23-noarch-1.txz">
<URL>https://github.com/wandercone/HakoDeploy/releases/download/2026.05.23/hakodeploy-2026.05.23-noarch-1.txz</URL>
<SHA256>37fc00820b883a714fe6805481075d351d90ab13f6cffbc7dcab0ff1e8c6cf79</SHA256>
</FILE>

<!--
The 'install' script.
-->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
upgradepkg --install-new /boot/config/plugins/hakodeploy/hakodeploy-2026.05.23-noarch-1.txz

# cleanup old versions
rm -f $(ls /boot/config/plugins/hakodeploy/hakodeploy-*.txz 2>/dev/null | grep -v '2026.05.23')

echo ""
echo "----------------------------------------------------"
echo " hakodeploy has been installed."
echo " Version: 2026.05.23"
echo "----------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<!--
The 'remove' script.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
removepkg hakodeploy

rm -rf /usr/local/emhttp/plugins/hakodeploy
rm -rf /boot/config/plugins/hakodeploy
]]>
</INLINE>
</FILE>

</PLUGIN>
