<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN>

<PLUGIN 
  name="hakodeploy"
  author="wandercone"
  version="2026.03.24"
  launch="Utilities/HakoDeploy"
  pluginURL="https://raw.githubusercontent.com/wandercone/HakoDeploy/main/plugin/hakodeploy.plg"
  support="https://forums.unraid.net/topic/197930-plugin-hakodeploy/"
  
  
  icon="server"
>

<CHANGES>
<![CDATA[

### 2026.03.24

Initial release of plugin


For older releases, see https://github.com/wandercone/HakoDeploy/releases
]]>
</CHANGES>

<FILE Name="/boot/config/plugins/hakodeploy/hakodeploy-2026.03.24-noarch-1.txz">
<URL>https://github.com/wandercone/HakoDeploy/releases/download/2026.03.24/hakodeploy-2026.03.24-noarch-1.txz</URL>
<SHA256>972e625dfef165f87603ec10b315deffef812009b742e2c1e7abb2a00ff1a276</SHA256>
</FILE>

<!--
The 'install' script.
-->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
upgradepkg --install-new /boot/config/plugins/hakodeploy/hakodeploy-2026.03.24-noarch-1.txz

# cleanup old versions
rm -f $(ls /boot/config/plugins/hakodeploy/hakodeploy-*.txz 2>/dev/null | grep -v '2026.03.24')

echo ""
echo "----------------------------------------------------"
echo " hakodeploy has been installed."
echo " Version: 2026.03.24"
echo "----------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<!--
The 'remove' script.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
removepkg hakodeploy

rm -rf /usr/local/emhttp/plugins/hakodeploy
rm -rf /boot/config/plugins/hakodeploy
]]>
</INLINE>
</FILE>

</PLUGIN>
