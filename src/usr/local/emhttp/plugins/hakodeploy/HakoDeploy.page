<script>
function toggleRow(row) {
  const cb = row.querySelector('input[type=checkbox]');
  if (!cb) return;
  cb.checked = !cb.checked;
  syncSelectAll(cb.name);
}

function toggleAll(name, checked) {
  document.querySelectorAll(`input[name="${name}"]`).forEach(cb => cb.checked = checked);
}

function syncSelectAll(name) {
  if (name === 'block_devices[]') {
    const all  = document.querySelectorAll('input[name="block_devices[]"]');
    const master = document.getElementById('selectAllDrives');
    if (master) master.checked = all.length > 0 && [...all].every(cb => cb.checked);
  }
}

function generateSecret() {
  const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
  const arr   = new Uint8Array(48);
  crypto.getRandomValues(arr);
  document.getElementById('secretInput').value =
    Array.from(arr, b => chars[b % chars.length]).join('');
  document.getElementById('generateBtn').style.display = 'none';
}

function collectParams(action) {
  const form    = document.getElementById('hfForm');
  const blocks  = [...form.querySelectorAll('input[name="block_devices[]"]:checked')].map(e => e.value);
  const serials = [...form.querySelectorAll('input[name="serial_devices[]"]:checked')].map(e => e.value);
  return new URLSearchParams({
    action,
    APPDATA_PATH:     form.querySelector('[name=APPDATA_PATH]').value,
    WEB_PORT:         form.querySelector('[name=WEB_PORT]').value,
    PUID:             form.querySelector('[name=PUID]').value,
    PGID:             form.querySelector('[name=PGID]').value,
    OPEN_ACCESS:      form.querySelector('[name=OPEN_ACCESS]').value,
    NETWORK:          form.querySelector('[name=NETWORK]').value,
    SHELL:            form.querySelector('[name=SHELL]').value,
    TAILSCALE:        form.querySelector('[name=TAILSCALE]').value,
    IMAGE_TAG:        form.querySelector('[name=IMAGE_TAG]').value,
    SECRET:           form.querySelector('[name=SECRET]').value,
    SELECTED_DEVICES: blocks.join(','),
    SELECTED_SERIAL:  serials.join(','),
  });
}

function showOutput(text, isSuccess) {
  const el = document.getElementById('hfOutput');
  el.textContent = text;
  el.style.display = 'block';
  el.style.color = isSuccess ? '' : 'var(--red, #ef5350)';
  el.scrollTop = 0;
}

async function postJson(params) {
  const resp = await fetch('/plugins/hakodeploy/include/ajax.php', {
    method:  'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    body:    params.toString(),
  });
  if (resp.status === 403) {
    throw new Error('Access denied.');
  }
  if (!resp.ok) {
    throw new Error('Server returned ' + resp.status);
  }
  return resp.json();
}

async function deployContainer() {
  if (!confirm('Apply settings and deploy the HakoFoundry container?')) return;
  const btn = document.getElementById('deployBtn');
  btn.disabled = true;

  try {
    showOutput('Applying configuration and deploying\u2026', true);
    const data = await postJson(collectParams('apply_and_deploy'));
    showOutput(data.message, data.success);

    if (data.success) {
      setTimeout(() => location.reload(), 2000);
    }
  } catch (e) {
    showOutput('Error: ' + e.message, false);
  }

  btn.disabled = false;
}

function pollStatus() {
  fetch('/plugins/hakodeploy/include/ajax.php', {
    method:  'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    body:    'action=status',
  })
  .then(r => r.json())
  .then(data => {
    const el = document.getElementById('hfContainerStatus');
    if (el) el.textContent = data.container_status;
  })
  .catch(() => {});
}
setInterval(pollStatus, 10000);
</script>
