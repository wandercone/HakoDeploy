<?php
require_once "/usr/local/emhttp/plugins/dynamix/include/Helpers.php";

$pluginName = "hakodeploy";
$cfg        = parse_plugin_cfg($pluginName);

$varIni = parse_ini_file('/var/local/emhttp/var.ini') ?: [];

$blockDevices = [];
$lsblkLines   = [];
exec('lsblk -d -n -o NAME,SIZE,MODEL,ROTA --pairs 2>/dev/null', $lsblkLines);
foreach ($lsblkLines as $line) {
    if ( ! preg_match('/NAME="(sd[a-z]+|nvme\d+n\d+)"/', $line)) {
        continue;
    }
    preg_match('/NAME="([^"]*)"/', $line, $nm);
    preg_match('/SIZE="([^"]*)"/', $line, $sz);
    preg_match('/MODEL="([^"]*)"/', $line, $md);
    preg_match('/ROTA="([^"]*)"/', $line, $ro);

    $isRotational = ($ro[1] ?? '1') === '1';
    $name         = $nm[1] ?? '';
    if ($name === '') {
        continue;
    }

    $blockDevices[] = [
        'path'  => '/dev/' . $name,
        'size'  => $sz[1] ?? '',
        'model' => trim($md[1] ?? 'Unknown'),
        'type'  => str_starts_with($name, 'nvme') ? 'NVMe'
                 : ($isRotational ? 'HDD' : 'SSD'),
    ];
}

$serialDevices = glob('/dev/ttyACM*') ?: [];

$selectedBlock  = array_filter(explode(',', $cfg['SELECTED_DEVICES'] ?? ''));
$selectedSerial = array_filter(explode(',', $cfg['SELECTED_SERIAL'] ?? ''));

exec('docker inspect --format "{{.State.Status}}" HakoFoundry 2>/dev/null', $statusOut, $rc);
$containerStatus   = ($rc === 0 && ! empty($statusOut[0])) ? $statusOut[0] : 'not installed';
$templateInstalled = file_exists('/boot/config/plugins/dockerMan/templates-user/my-HakoFoundry.xml');

$dockerNetworks = [];
$netLines       = [];
exec("docker network ls --format '{{.Name}}={{.Driver}}' 2>/dev/null", $netLines);
foreach ($netLines as $line) {
    [$name, $driver] = array_pad(explode('=', $line, 2), 2, '');
    if ($name !== '') {
        $dockerNetworks[$name] = $driver;
    }
}
